# The compiled server. Anchored to the repo root so it cannot match the
# web/ assets or anything else that shares the name.
/llm-pivot

# Go build and test artefacts
*.test
*.out
coverage.*

# Local GOPATH and build cache, when they are kept inside the repository
/.gopath/
/.gocache/

# Local configuration written by the monitor page, if kept beside the source
/config.yaml
/config.yaml.bak*

# Editor and OS noise
*~
*.swp
.idea/
.vscode/
.DS_Store
