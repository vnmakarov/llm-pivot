[Unit]
Description=engine-router - start, stop and monitor local LLM engines
Documentation=file:%h/GITHUB/engine-router/README.md
After=network.target

[Service]
Type=exec
WorkingDirectory=%h
ExecStart=%h/GITHUB/engine-router/engine-router --config %h/.config/engine-router/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# engine-router forwards SIGTERM to the engine it started and waits for it.
KillMode=mixed
TimeoutStopSec=45

Environment=HOME=%h
SyslogIdentifier=engine-router

[Install]
WantedBy=default.target
